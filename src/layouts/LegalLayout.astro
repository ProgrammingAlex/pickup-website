---
import BaseLayout from './BaseLayout.astro';

const { title, description, heading, updated } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="legal">
    <div class="container legal-inner">
      <header class="legal-head">
        <p class="eyebrow">Pick-Up</p>
        <h1>{heading}</h1>
        <p class="updated muted">Last updated: {updated}</p>
      </header>

      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Scoped by the .legal wrapper so nothing leaks to other pages. */

  .legal { padding-block: var(--space-lg) var(--space-xl); }

  .legal-inner { max-width: 760px; }

  .legal-head {
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }
  .legal-head h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    margin-block: var(--space-xs) var(--space-xs);
  }
  .legal .updated { font-size: 0.9rem; }

  .legal h2 {
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .legal h3 {
    font-size: 1.08rem;
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
    color: var(--text);
  }

  .legal p {
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .legal ul,
  .legal ol {
    color: var(--text-muted);
    padding-left: 1.4rem;
    margin-bottom: var(--space-sm);
  }
  .legal li { margin-bottom: 0.5rem; }

  .legal strong { color: var(--text); font-weight: 650; }

  .legal a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal a:hover { color: var(--text); }

  /* Callout — the "short version" / "zero tolerance" blocks */
  .legal .note {
    background: var(--surface);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-md);
  }
  .legal .note p:last-child { margin-bottom: 0; }

  /* Boxed step / instruction blocks */
  .legal .box {
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-sm);
  }
  .legal .box p:last-child { margin-bottom: 0; }

  /* Prominent contact block on the support page */
  .legal .contact {
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-md);
    margin-bottom: var(--space-md);
    text-align: center;
  }
  .legal .contact .email {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 650;
    margin-block: 0.35rem;
  }
  .legal .contact .small {
    font-size: 0.88rem;
    margin-bottom: 0;
  }
</style>