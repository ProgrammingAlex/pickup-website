---
// Download buttons, plus an optional QR code that only shows on computers
// (a QR code is useless on the phone you would scan it with).
// variant: "hero" (left-aligned on desktop) or "centered"
import { APP_STORE_URL, PLAY_STORE_URL, ANDROID_FALLBACK } from '../config';

const { variant = 'centered', qr = false } = Astro.props;
const playLive = PLAY_STORE_URL !== '';
---
<div class:list={['store-links', variant]}>
  <div class="store-buttons">
    <a class="store-btn store-btn--primary" href={APP_STORE_URL} rel="noopener">
      <small>Download on the</small>
      <span>App Store</span>
    </a>

    {playLive ? (
      <a class="store-btn" href={PLAY_STORE_URL} rel="noopener">
        <small>Get it on</small>
        <span>Google Play</span>
      </a>
    ) : (
      <a class="store-btn" href={ANDROID_FALLBACK}>
        <small>On Android?</small>
        <span>Join the test</span>
      </a>
    )}
  </div>

  {qr && (
    <div class="qr">
      <img src="/qr-get.svg" alt="QR code that opens Pick-Up on your phone" width="132" height="132" />
      <p class="muted">
        Scan with your phone's camera.{' '}
        {playLive
          ? 'It opens the App Store on iPhone and Google Play on Android.'
          : 'It opens the App Store on iPhone and the test invite on Android.'}
      </p>
    </div>
  )}

  <p class="fineprint muted">Free. No account. Canada and the US.</p>
</div>

<style>
  .store-links { width: 100%; margin-top: var(--space-md); }

  .store-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }

  .store-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 11rem;
    padding: 0.6rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-alt);
    color: var(--text);
    text-decoration: none;
    text-align: left;
    line-height: 1.2;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .store-btn small {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .store-btn span {
    font-size: 1.15rem;
    font-weight: 650;
  }
  .store-btn:hover { border-color: var(--text-muted); }

  .store-btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .store-btn--primary small { color: rgba(255, 255, 255, 0.82); }
  .store-btn--primary:hover {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
  }

  .store-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* --- QR: hidden on phones and tablets, shown on computers only --- */
  .qr {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    max-width: 420px;
    margin-inline: auto;
    text-align: left;
  }
  .qr img {
    flex: none;
    width: 132px;
    height: 132px;
    padding: 8px;
    background: #fff;
    border-radius: var(--radius);
  }
  .qr p { font-size: 0.92rem; line-height: 1.5; }

  @media (min-width: 860px) and (hover: hover) and (pointer: fine) {
    .qr { display: flex; }
  }

  .fineprint {
    font-size: 0.85rem;
    margin-top: var(--space-sm);
    text-align: center;
  }

  /* --- hero variant: centred on mobile, left-aligned on desktop --- */
  @media (min-width: 860px) {
    .hero .store-buttons { justify-content: flex-start; }
    .hero .qr { margin-inline: 0; }
    .hero .fineprint { text-align: left; }
  }
</style>
