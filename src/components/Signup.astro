---
// variant: "hero" (left-aligned on desktop) or "centered"
const { variant = 'centered' } = Astro.props;

// Unique ids so two copies on one page don't collide.
const uid = 'su-' + Math.random().toString(36).slice(2, 9);
---
<div class:list={['signup-wrap', variant]}>
  <form class="signup" novalidate>
    <fieldset class="platform">
      <legend>Which phone do you have?</legend>
      <label class="pill">
        <input type="radio" name={uid + '-platform'} value="ios" data-platform />
        <span>iPhone</span>
      </label>
      <label class="pill">
        <input type="radio" name={uid + '-platform'} value="android" data-platform />
        <span>Android</span>
      </label>
    </fieldset>

    <div class="row">
      <input
        type="email"
        name="email"
        class="signup-email"
        placeholder="you@email.com"
        required
        autocomplete="email"
        aria-label="Email address"
      />
      <!-- Honeypot: hidden from people, filled in by bots. -->
      <input
        type="text"
        name="company"
        class="signup-hp"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <button type="submit" class="btn signup-btn">Notify me at launch</button>
    </div>
  </form>

  <p class="signup-msg" role="status" aria-live="polite"></p>
  <p class="fineprint muted">Free app. One email at launch, nothing else.</p>
</div>

<style>
  .signup-wrap { width: 100%; }

  .signup {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: var(--space-md) auto 0;
    width: 100%;
    max-width: 480px;
  }

  /* --- platform radio group --- */
  .platform {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-xs);
    justify-content: center;
    flex-wrap: wrap;
  }
  .platform legend {
    float: left;
    width: 100%;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
    text-align: center;
  }

  .pill { cursor: pointer; }
  .pill input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .pill span {
    display: block;
    padding: 0.55rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-alt);
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .pill:hover span { color: var(--text); }
  .pill input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .pill input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .platform.invalid span { border-color: var(--accent); }

  /* --- email row --- */
  .row {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }

  .signup-email {
    flex: 1 1 220px;
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    padding: 0.9rem 1rem;
  }
  .signup-email:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .signup-email.invalid { border-color: var(--accent); }

  /* Visually removed, still focusable by bots that ignore CSS. */
  .signup-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .signup-btn[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .signup-msg {
    margin-top: var(--space-xs);
    font-size: 0.9rem;
    min-height: 1.4em;
    color: var(--text-muted);
  }
  .signup-msg.ok { color: var(--text); font-weight: 500; }
  .signup-msg.err { color: var(--accent); }

  .fineprint {
    font-size: 0.85rem;
    margin-top: var(--space-xs);
  }

  /* --- centered variant (default) --- */
  .centered .signup-msg,
  .centered .fineprint { text-align: center; }

  /* --- hero variant: centred on mobile, left-aligned on desktop --- */
  @media (min-width: 860px) {
    .hero .signup { margin-inline: 0; }
    .hero .platform,
    .hero .row { justify-content: flex-start; }
    .hero .platform legend { text-align: left; }
    .hero .signup-msg,
    .hero .fineprint { text-align: left; }
  }
</style>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  const looksLikeEmail = (value = '') => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

  document.querySelectorAll('.signup').forEach((element) => {
    if (!(element instanceof HTMLFormElement)) return;

    const form = element;
    const wrap = form.closest('.signup-wrap');
    if (!(wrap instanceof HTMLElement)) return;

    const input = form.querySelector('.signup-email');
    const honey = form.querySelector('.signup-hp');
    const button = form.querySelector('.signup-btn');
    const message = wrap.querySelector('.signup-msg');
    const group = form.querySelector('.platform');

    if (!(input instanceof HTMLInputElement)) return;
    if (!(honey instanceof HTMLInputElement)) return;
    if (!(button instanceof HTMLButtonElement)) return;
    if (!(message instanceof HTMLElement)) return;
    if (!(group instanceof HTMLElement)) return;

    const defaultLabel = button.textContent || 'Notify me at launch';

    const say = (text = '', kind = '') => {
      message.textContent = text;
      message.className = kind ? 'signup-msg ' + kind : 'signup-msg';
    };

    const chosenPlatform = () => {
      const picked = form.querySelector('input[data-platform]:checked');
      return picked instanceof HTMLInputElement ? picked.value : '';
    };

    input.addEventListener('input', () => {
      input.classList.remove('invalid');
      if (message.classList.contains('err')) say();
    });

    group.addEventListener('change', () => {
      group.classList.remove('invalid');
      if (message.classList.contains('err')) say();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = input.value.trim();
      const platform = chosenPlatform();

      if (!platform) {
        group.classList.add('invalid');
        say('Pick iPhone or Android so we know which link to send you.', 'err');
        return;
      }

      if (!looksLikeEmail(email)) {
        input.classList.add('invalid');
        say('That does not look like an email address.', 'err');
        input.focus();
        return;
      }

      // Bot filled the hidden field — pretend it worked, send nothing.
      if (honey.value) {
        say('You are on the list. We will email you once.', 'ok');
        return;
      }

      button.disabled = true;
      button.textContent = 'Adding you…';
      say();

      try {
        const response = await fetch(SUPABASE_URL + '/rest/v1/waitlist', {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal',
          },
          body: JSON.stringify({
            email: email,
            platform: platform,
            source: 'website',
          }),
        });

        // 409 = duplicate email. Same outcome from the visitor's side.
        if (response.ok || response.status === 409) {
          form.remove();
          const note = platform === 'android'
            ? 'You are on the list. Android testers get an invite link first — watch your inbox.'
            : 'You are on the list. We will email you the App Store link at launch.';
          say(note, 'ok');
          return;
        }

        throw new Error('Request failed with status ' + response.status);
      } catch (error) {
        console.error('Waitlist signup failed:', error);
        say('Something went wrong. Email PickUpHelp@proton.me and we will add you.', 'err');
        button.disabled = false;
        button.textContent = defaultLabel;
      }
    });
  });
</script>