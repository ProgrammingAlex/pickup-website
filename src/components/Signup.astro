---
// Android closed-test invite form.
// Posts to the same Supabase `waitlist` table, always with platform "android".
---
<div class="signup-wrap">
  <form class="signup" novalidate>
    <div class="row">
      <input
        type="email"
        name="email"
        class="signup-email"
        placeholder="you@gmail.com"
        required
        autocomplete="email"
        aria-label="Google account email"
      />
      <!-- Honeypot: hidden from people, filled in by bots. -->
      <input
        type="text"
        name="company"
        class="signup-hp"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <button type="submit" class="btn signup-btn">Send me an invite</button>
    </div>
  </form>

  <p class="signup-msg" role="status" aria-live="polite"></p>
  <p class="fineprint muted">
    Use the Google account signed in on your Android phone — Google Play needs
    that exact one for the invite. We email you the invite, then once more when
    Pick-Up is public on Google Play. Nothing else.
  </p>
</div>

<style>
  .signup-wrap { width: 100%; }

  .signup {
    margin: var(--space-md) auto 0;
    width: 100%;
    max-width: 480px;
  }

  .row {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }

  .signup-email {
    flex: 1 1 220px;
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    padding: 0.9rem 1rem;
  }
  .signup-email:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .signup-email.invalid { border-color: var(--accent); }

  /* Visually removed, still focusable by bots that ignore CSS. */
  .signup-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .signup-btn[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .signup-msg {
    margin-top: var(--space-xs);
    font-size: 0.9rem;
    min-height: 1.4em;
    color: var(--text-muted);
    text-align: center;
  }
  .signup-msg.ok {
    color: var(--text);
    font-weight: 500;
    font-size: 1rem;
    margin-top: var(--space-md);
  }
  .signup-msg.err { color: var(--accent); }

  .fineprint {
    font-size: 0.85rem;
    margin: var(--space-xs) auto 0;
    max-width: 52ch;
    text-align: center;
  }
  .fineprint.hidden { display: none; }
</style>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  // New key on purpose: the old waitlist key could hold "ios" from the
  // pre-release form, which would wrongly hide this Android-only form.
  const STORAGE_KEY = 'pickup-android-invite';
  const DONE_NOTE = 'You are on the list. Watch your inbox for the Android test invite.';

  const looksLikeEmail = (value = '') => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

  const instances = [];

  document.querySelectorAll('.signup').forEach((element) => {
    if (!(element instanceof HTMLFormElement)) return;

    const form = element;
    const wrap = form.closest('.signup-wrap');
    if (!(wrap instanceof HTMLElement)) return;

    const input = form.querySelector('.signup-email');
    const honey = form.querySelector('.signup-hp');
    const button = form.querySelector('.signup-btn');
    const message = wrap.querySelector('.signup-msg');
    const fineprint = wrap.querySelector('.fineprint');

    if (!(input instanceof HTMLInputElement)) return;
    if (!(honey instanceof HTMLInputElement)) return;
    if (!(button instanceof HTMLButtonElement)) return;
    if (!(message instanceof HTMLElement)) return;
    if (!(fineprint instanceof HTMLElement)) return;

    instances.push({ form, input, honey, button, message, fineprint });
  });

  const markAllDone = () => {
    instances.forEach((item) => {
      item.form.remove();
      item.fineprint.classList.add('hidden');
      item.message.textContent = DONE_NOTE;
      item.message.className = 'signup-msg ok';
    });
  };

  try {
    if (localStorage.getItem(STORAGE_KEY)) markAllDone();
  } catch (error) {
    // Private browsing can block localStorage. Not worth failing over.
  }

  instances.forEach((item) => {
    const { form, input, honey, button, message } = item;
    const defaultLabel = button.textContent || 'Send me an invite';

    const say = (text = '', kind = '') => {
      message.textContent = text;
      message.className = kind ? 'signup-msg ' + kind : 'signup-msg';
    };

    input.addEventListener('input', () => {
      input.classList.remove('invalid');
      if (message.classList.contains('err')) say();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = input.value.trim();

      if (!looksLikeEmail(email)) {
        input.classList.add('invalid');
        say('That does not look like an email address.', 'err');
        input.focus();
        return;
      }

      // Bot filled the hidden field — pretend it worked, send nothing.
      if (honey.value) {
        markAllDone();
        return;
      }

      button.disabled = true;
      button.textContent = 'Adding you…';
      say();

      try {
        const response = await fetch(SUPABASE_URL + '/rest/v1/waitlist', {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal',
          },
          body: JSON.stringify({
            email: email,
            platform: 'android',
            source: 'website',
          }),
        });

        // 409 = duplicate email. Same outcome from the visitor's side.
        if (response.ok || response.status === 409) {
          try {
            localStorage.setItem(STORAGE_KEY, '1');
          } catch (error) {
            // Storage blocked — the in-page state below still works.
          }
          markAllDone();
          return;
        }

        throw new Error('Request failed with status ' + response.status);
      } catch (error) {
        console.error('Android invite signup failed:', error);
        say('Something went wrong. Email PickUpHelp@proton.me and we will add you.', 'err');
        button.disabled = false;
        button.textContent = defaultLabel;
      }
    });
  });
</script>
