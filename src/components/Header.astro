---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <Image src={logo} alt="" width={34} height={34} />
      <span class="wordmark">Pick&#8209;Up</span>
    </a>
    <nav>
      <a href="/#how" class="nav-hide-sm">How it works</a>
      <a href="/support">Support</a>
      <a href="/get" class="nav-cta">Get the app</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(18, 18, 18, 0.85);
    backdrop-filter: blur(10px);
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
  }
  .brand :global(img) {
    display: block;
    width: 34px;
    height: 34px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  nav {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }
  nav a {
    font-size: 0.95rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  nav a:hover { color: var(--text); }

  nav a.nav-cta {
    background: var(--accent);
    color: #fff;
    font-weight: 650;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
  }
  nav a.nav-cta:hover {
    background: var(--accent-dark);
    color: #fff;
  }

  /* Phones: keep the header to Support + Get the app. */
  @media (max-width: 480px) {
    .nav-hide-sm { display: none; }
  }
</style>
