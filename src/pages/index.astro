---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import StoreLinks from '../components/StoreLinks.astro';
import Signup from '../components/Signup.astro';

import shotMap from '../assets/screens/screen-map.png';
import shotPickDay from '../assets/screens/screen-pick-day.png';
import shotJoin from '../assets/screens/screen-join.png';
import shotGames from '../assets/screens/screen-games.png';
import shotPickSport from '../assets/screens/screen-pick-sport.png';
import shotCheckIn from '../assets/screens/screen-check-in.png';
import shotChat from '../assets/screens/screen-chat.png';
import shotSettings from '../assets/screens/screen-settings.png';

const tracks = [
  {
    label: 'Plan ahead',
    title: 'Join a game at a spot near you',
    steps: [
      {
        n: '01',
        title: 'Tap a pin, pick a day',
        body: 'Every park, field and court nearby has a pin on the map. Tap one to see the next seven days and how many people are going each day.',
        img: shotPickDay,
        alt: 'A basketball spot open on the map, with the next few days and how many people are going on each',
      },
      {
        n: '02',
        title: 'Pick a time and tap Join',
        body: 'Choose a time, see how many people are in, and join. Directions open straight in Google Maps or Apple Maps.',
        img: shotJoin,
        alt: 'A 5:00 PM basketball game with 2 people going, a Join button and a Directions button',
      },
      {
        n: '03',
        title: 'Keep track of your games',
        body: 'Everything you join lands in the Games tab, so you always know where you are playing next.',
        img: shotGames,
        alt: 'The Games tab listing upcoming soccer, basketball and tennis games',
      },
    ],
  },
  {
    label: 'Play right now',
    title: 'Get matched with players nearby',
    steps: [
      {
        n: '01',
        title: 'Pick your sport and range',
        body: 'Tap search, choose a sport, then set how far you will travel — anywhere from 1 to 100 km.',
        img: shotPickSport,
        alt: 'Choosing a sport for a search: pickleball singles, pickleball doubles or basketball',
      },
      {
        n: '02',
        title: 'Check in once, then close the app',
        body: 'Your check-in lasts 24 hours and never renews on its own. We notify you when someone matches. Your location is never shown to other players.',
        img: shotCheckIn,
        alt: 'Confirming a 24-hour basketball check-in within 1 km',
      },
      {
        n: '03',
        title: 'Plan it in a group chat',
        body: 'Everyone who matches drops into a shared chat for 48 hours. Sort out a time and a place, then go play.',
        img: shotChat,
        alt: 'A group chat between two matched basketball players',
      },
    ],
  },
];

const sports = ['Basketball', 'Soccer', 'Baseball', 'Tennis', 'Pickleball', 'Volleyball', 'Badminton'];
---
<BaseLayout
  title="Pick-Up — Find people to play sports with near you"
  description="See where people are playing, join a game at a park near you, or get matched with players right now. No account needed. Free on iPhone, Android in testing."
>
  <!-- ========== HERO ========== -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Free on iPhone &middot; Android in testing</p>
        <h1>Find a game at the park down the street.</h1>
        <p class="lead">
          See where people are playing, join a game on the day and time that
          suits you, or check in and get matched with players nearby right
          now. No account needed.
        </p>

        <StoreLinks variant="hero" qr />
      </div>

      <div class="hero-shot">
        <PhoneFrame
          src={shotMap}
          alt="The Pick-Up map with a pin for each nearby spot to play, orange numbers showing how many people have joined"
          width={300}
        />

        <div class="hero-sports-block">
          <p class="eyebrow">Sports</p>
          <ul class="sport-chips">
            {sports.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROBLEM ========== -->
  <section class="section section--tint">
    <div class="container narrow">
      <h2>Everywhere to play. Nobody playing.</h2>
      <p class="lead wide">
        Your neighbourhood is full of empty parks, fields and courts — not
        because nobody wants a game, but because nobody knows who else is free.
        There is no way to find the handful of people a few streets over with a
        free hour and nothing to do with it. Pick-Up is that missing step.
      </p>
    </div>
  </section>

  <!-- ========== HOW IT WORKS ========== -->
  <section class="section" id="how">
    <div class="container">
      <div class="how-head">
        <p class="eyebrow">How it works</p>
        <h2>Two ways to get a game.</h2>
      </div>

      {tracks.map((t) => (
        <div class="track">
          <div class="track-head">
            <span class="track-label">{t.label}</span>
            <h3>{t.title}</h3>
          </div>

          <ol class="steps">
            {t.steps.map((s) => (
              <li class="step">
                <PhoneFrame src={s.img} alt={s.alt} width={240} />
                <div class="step-text">
                  <span class="step-n">{s.n}</span>
                  <h3>{s.title}</h3>
                  <p class="muted">{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <!-- ========== NO ACCOUNT ========== -->
  <section class="section section--tint">
    <div class="container split">
      <div class="split-text">
        <h2>No account. Seriously.</h2>
        <p class="lead">
          No email, no password, no profile picture, no follower count. Pick a
          nickname if you want one, or stay Anonymous. Turn off the sports you
          don't play and they disappear from the map.
        </p>
        <p class="lead">
          We are not trying to build a social network — we are trying to get
          you outside.
        </p>
      </div>
      <PhoneFrame
        src={shotSettings}
        alt="Settings with an optional nickname, a list of sports to show on the map, and a location matching switch"
        width={260}
      />
    </div>
  </section>

  <!-- ========== DOWNLOAD ========== -->
  <section class="section" id="download">
    <div class="container narrow">
      <p class="eyebrow">Get Pick-Up</p>
      <h2>Free on iPhone. Android is close.</h2>
      <p class="lead wide">
        Download it from the App Store, or point your phone's camera at the
        code below.
      </p>

      <StoreLinks variant="centered" qr />
    </div>
  </section>

  <!-- ========== ANDROID TEST ========== -->
  <section class="section section--tint" id="android">
    <div class="container narrow">
      <p class="eyebrow">On Android?</p>
      <h2>Get an invite to the test.</h2>
      <p class="lead wide">
        Pick-Up for Android is in a closed test on Google Play. Leave your
        email and we will send you an invite to join.
      </p>

      <Signup />
    </div>
  </section>
</BaseLayout>

<style>
  /* ================= HERO =================
     All alignment lives on .hero-grid and cascades down. */
  .hero { padding-block: var(--space-lg) var(--space-xl); }

  .hero-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    justify-items: center;
    text-align: center;
  }

  .hero-copy { max-width: 560px; }
  .hero-copy h1 { margin-block: var(--space-xs) var(--space-md); }
  .hero-copy .lead { margin-inline: auto; }

  .hero-shot {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* --- sports chips under the phone --- */
  .hero-sports-block {
    margin-top: var(--space-md);
    text-align: center;
    max-width: 340px;
  }
  .hero-sports-block .eyebrow { margin-bottom: var(--space-sm); }

  .sport-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: center;
  }
  .sport-chips li {
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-alt);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  /* ================= PROBLEM / DOWNLOAD / ANDROID ================= */
  .narrow { max-width: 780px; text-align: center; }
  .narrow h2 { margin-bottom: var(--space-sm); }
  .narrow .eyebrow { margin-bottom: var(--space-xs); }
  .lead.wide { max-width: 62ch; margin-inline: auto; }

  /* ================= HOW IT WORKS ================= */
  .how-head {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .how-head h2 { margin-top: var(--space-xs); }

  .track + .track {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .track-head {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .track-label {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }
  .track-head h3 { font-size: 1.4rem; }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }
  .step {
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    text-align: center;
  }
  .step-n {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--accent);
    margin-bottom: var(--space-xs);
  }
  .step-text h3 { margin-bottom: var(--space-xs); }
  .step-text p { max-width: 42ch; margin-inline: auto; }

  /* ================= NO ACCOUNT ================= */
  .split {
    display: grid;
    gap: var(--space-lg);
    justify-items: center;
    text-align: center;
  }
  .split-text { max-width: 560px; }
  .split-text h2 { margin-bottom: var(--space-sm); }
  .split-text .lead { margin-inline: auto; }
  .split-text .lead + .lead { margin-top: var(--space-sm); }

  /* ================= DESKTOP ================= */
  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      text-align: left;
      justify-items: start;
      /* Top-align the columns so the phone can line up with the headline. */
      align-items: start;
    }
    .hero-copy .lead { margin-inline: 0; }
    .hero-shot { margin-top: 1.85rem; justify-self: center; }

    .steps { grid-template-columns: repeat(3, 1fr); align-items: start; }

    .split {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      text-align: left;
    }
    .split-text { justify-self: start; }
    .split-text .lead { margin-inline: 0; }
  }
</style>
