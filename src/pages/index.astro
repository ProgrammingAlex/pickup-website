---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Signup from '../components/Signup.astro';
import { Image } from 'astro:assets';

import shotHome from '../assets/screens/screen-home.png';
import shotRadius from '../assets/screens/screen-radius.png';
import shotSearching from '../assets/screens/screen-searching.png';
import shotChat from '../assets/screens/screen-chat.png';

import iconBasketball from '../assets/sports/basketball.png';
import iconPickleball from '../assets/sports/pickleball.png';
import iconSoccer from '../assets/sports/soccer.png';

const steps = [
  {
    n: '01',
    title: 'Set your sport and your range',
    body: 'Pick a sport, use your current location or type in a different address, then drag the radius anywhere from 1 to 100 km. You decide how far you are willing to travel.',
    img: shotRadius,
    alt: 'Selecting a 56 km search radius on a map of the Toronto area',
  },
  {
    n: '02',
    title: 'Check in, then close the app',
    body: 'You see exactly what you are about to search for before anything goes live. Tap check in and it stays active for 24 hours — no refreshing, no sitting on the screen waiting.',
    img: shotSearching,
    alt: 'A basketball search showing as active with a 24-hour countdown',
  },
  {
    n: '03',
    title: 'Land in a group chat',
    body: 'When players match, everyone drops into a shared chat for 48 hours. Sort out a time and a place, then go play.',
    img: shotChat,
    alt: 'A group chat between matched players',
  },
];

const sports = [
  { name: 'Basketball', icon: iconBasketball },
  { name: 'Pickleball', icon: iconPickleball },
  { name: 'Soccer', icon: iconSoccer },
];
---
<BaseLayout
  title="Pick-Up — Check in for a sport, get matched with players nearby"
  description="Check in for a sport and get matched with players nearby. No account, no profile, no sign-up. Launching spring 2027 on iOS and Android."
>
  <!-- ========== HERO ========== -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Spring 2027 &middot; iOS &amp; Android</p>
        <h1>Check in for a sport. Get matched with players nearby. No account needed.</h1>
        <p class="lead">
          Set your sport and how far you'll travel, then check in. Your search
          stays live for 24 hours — close the app and we'll tell you when
          someone matches.
        </p>

        <Signup variant="hero" />
      </div>

      <div class="hero-shot">
        <PhoneFrame src={shotHome} alt="The Pick-Up home screen showing a globe with a search button" width={320} />

        <ul class="hero-sports">
          {sports.map((s) => (
            <li>
              <Image src={s.icon} alt={s.name} width={46} height={46} />
            </li>
          ))}
        </ul>
        <p class="hero-sports-note muted">
          Basketball, pickleball and soccer at launch. More coming.
        </p>
      </div>
    </div>
  </section>

  <!-- ========== PROBLEM ========== -->
  <section class="section section--tint">
    <div class="container narrow">
      <h2>Everywhere to play. Nobody playing.</h2>
      <p class="lead wide">
        Your neighbourhood is full of empty parks, fields and courts — not
        because nobody wants a game, but because nobody knows who else is free.
        There is no way to find the handful of people a few streets over with a
        free hour and nothing to do with it. Pick-Up is that missing step.
      </p>
    </div>
  </section>

  <!-- ========== HOW IT WORKS ========== -->
  <section class="section" id="how">
    <div class="container">
      <div class="how-head">
        <p class="eyebrow">How it works</p>
        <h2>Set it up once. Get on with your day.</h2>
      </div>

      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <PhoneFrame src={s.img} alt={s.alt} width={260} />
            <div class="step-text">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== NO ACCOUNT ========== -->
  <section class="section section--tint">
    <div class="container narrow">
      <h2>No account. Seriously.</h2>
      <p class="lead wide">
        No email, no password, no profile picture, no follower count.
        Everyone in a match shows up as Anonymous. We are not trying to
        build a social network — we are trying to get you outside.
      </p>
    </div>
  </section>

  <!-- ========== WHY SPRING + CLOSING CTA ========== -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Launching spring 2027</p>
      <h2>We are waiting for the weather.</h2>
      <p class="lead wide">
        Pick-Up only works when there are people outside to play with, so we are
        launching when the season starts rather than a few weeks before it ends.
        Join the list and you will hear from us once — the week it goes live.
      </p>

      <div class="closing-signup">
        <Signup variant="centered" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ================= HERO =================
     All alignment lives on .hero-grid and cascades down. */
  .hero { padding-block: var(--space-lg) var(--space-xl); }

  .hero-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    justify-items: center;
    text-align: center;
  }

  .hero-copy { max-width: 560px; }
  .hero-copy h1 { margin-block: var(--space-xs) var(--space-md); }
  .hero-copy .lead { margin-inline: auto; }

  .hero-shot {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* --- sports strip under the phone --- */
  .hero-sports {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 0;
    display: flex;
    gap: var(--space-md);
    align-items: center;
    justify-content: center;
  }
  .hero-sports :global(img) {
    display: block;
    width: 46px;
    height: 46px;
    opacity: 0.85;
  }
  .hero-sports-note {
    margin-top: var(--space-xs);
    font-size: 0.85rem;
    text-align: center;
    max-width: 34ch;
  }

  /* ================= PROBLEM / NO ACCOUNT / CLOSING ================= */
  .narrow { max-width: 780px; text-align: center; }
  .narrow h2 { margin-bottom: var(--space-sm); }
  .narrow .eyebrow { margin-bottom: var(--space-xs); }
  .lead.wide { max-width: 62ch; margin-inline: auto; }

  .closing-signup { margin-top: var(--space-lg); }

  /* ================= SECTION HEADINGS ================= */
  .how-head {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .how-head h2 { margin-top: var(--space-xs); }

  /* ================= STEPS ================= */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }
  .step {
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    text-align: center;
  }
  .step-n {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--accent);
    margin-bottom: var(--space-xs);
  }
  .step-text h3 { margin-bottom: var(--space-xs); }
  .step-text p { max-width: 42ch; margin-inline: auto; }

  /* ================= DESKTOP ================= */
  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      text-align: left;
      justify-items: start;
      /* Top-align the columns so the phone can line up with the headline. */
      align-items: start;
    }
    .hero-copy .lead { margin-inline: 0; }

    /* Push the phone down past the eyebrow line so its top edge sits level
       with the top of the h1. Eyebrow line-height + the h1's top margin. */
    .hero-shot { margin-top: 1.85rem; }

    .steps { grid-template-columns: repeat(3, 1fr); align-items: start; }
  }
</style>