import LegalLayout from '../layouts/LegalLayout.astro';
---
<LegalLayout
  title="Delete Your Data — Pick-Up"
  description="Delete all of your Pick-Up data instantly from Settings in the app, or email us and we will do it for you."
  heading="Delete Your Data"
  updated="November 2026"
>
  <div class="note">
    <p><strong>The short version:</strong> open Pick-Up, go to
    <strong>Settings</strong>, and tap <strong>Delete My Data</strong>.
    Everything tied to you is deleted on the spot, and you carry on as a
    brand-new anonymous player.</p>
  </div>

  <h2>Delete in the App</h2>

  <div class="box">
    <p><strong>Step 1 —</strong> Open Pick-Up and go to the
    <strong>Settings</strong> tab.</p>
  </div>

  <div class="box">
    <p><strong>Step 2 —</strong> Tap <strong>Delete My Data</strong> at the
    bottom of the page.</p>
  </div>

  <div class="box">
    <p><strong>Step 3 —</strong> Confirm by tapping
    <strong>Delete everything</strong>. Your data is deleted immediately and
    cannot be recovered.</p>
  </div>

  <h2>Can't Open the App?</h2>
  <p>
    If you no longer have the App installed, email
    <a href="mailto:PickUpHelp@proton.me">PickUpHelp@proton.me</a> with the
    subject line "Data Deletion Request." If you still have your Anonymous ID
    (shown in Settings), include it so we can find your data. We will delete it
    within <strong>30 days</strong>. You do not need to give us your name or
    any other personal information.
  </p>

  <h2>What Gets Deleted</h2>
  <ul>
    <li>Your anonymous account and ID</li>
    <li>Your nickname, if you set one</li>
    <li>Every game you have joined, and any game move you started</li>
    <li>Your messages, from every chat</li>
    <li>Your membership in any group chats</li>
    <li>Any active search (check-in)</li>
    <li>Your push notification token</li>
    <li>Any blocks you made, and any blocks others made of you</li>
  </ul>

  <h2>What Is Kept</h2>
  <p>
    Reports made by or about you are kept for moderation and safety, so that
    deleting data cannot be used to erase evidence of a policy violation. When
    you delete your data, your anonymous ID is removed from those reports, so
    they are no longer linked to you. This is also described in our
    <a href="/privacy">Privacy Policy</a>.
  </p>

  <h2>Questions</h2>
  <p>
    If you have any questions about deleting your data, contact us at
    <a href="mailto:PickUpHelp@proton.me">PickUpHelp@proton.me</a>.
  </p>
</LegalLayout>
