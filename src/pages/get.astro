---
// pickuphq.app/get — the link inside every Pick-Up QR code and share link.
// iPhone  -> App Store
// Android -> Google Play once PLAY_STORE_URL is set, until then the test invite
// Anything else (a computer) -> stays here and shows the buttons + QR code.
//
// Every visit is counted in the Supabase `get_visits` table first, tagged with
// where the link came from (?ref=) and the phone type. Nothing personal is
// stored: no IP, no device details, no location.
//   ?ref=app    in-app "Scan to get Pick-Up" QR code
//   ?ref=share  in-app Share link
//   ?ref=web    QR code on this website
//   ?ref=site   "Get the app" button in the website header
//   no ref      typed in or an old link -> stored as "direct"
// Posters, cards etc. can use their own, e.g. ?ref=poster-leonpark
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreLinks from '../components/StoreLinks.astro';
import { APP_STORE_URL, PLAY_STORE_URL, ANDROID_FALLBACK } from '../config';

const androidTarget = PLAY_STORE_URL || ANDROID_FALLBACK;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<BaseLayout
  title="Get Pick-Up"
  description="Download Pick-Up — find people to play sports with near you."
  noindex
>
  <script
    slot="head"
    is:inline
    define:vars={{ ios: APP_STORE_URL, android: androidTarget, sbUrl: supabaseUrl, sbKey: supabaseKey }}
  >
    (function () {
      var ua = navigator.userAgent || '';
      // iPadOS reports itself as a Mac, so also check for a touch screen.
      var isIOS = /iPhone|iPad|iPod/.test(ua) ||
        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      var isAndroid = /Android/i.test(ua);
      var platform = isIOS ? 'ios' : isAndroid ? 'android' : 'other';

      // Where the link came from. Lowercase letters, numbers, - and _ only,
      // so a mangled link can't put junk in the table.
      var ref = 'direct';
      try {
        var raw = (new URLSearchParams(location.search).get('ref') || '').toLowerCase();
        if (/^[a-z0-9_-]{1,32}$/.test(raw)) ref = raw;
        else if (raw) ref = 'other';
      } catch (e) {}

      var target = isIOS ? ios : isAndroid ? android : null;
      var done = false;
      var go = function () {
        if (done) return;
        done = true;
        if (target) location.replace(target);
      };

      // Count the visit, then redirect. Never wait more than 0.8 seconds —
      // a slow or failed count must not keep anyone from the store.
      try {
        fetch(sbUrl + '/rest/v1/get_visits', {
          method: 'POST',
          keepalive: true,
          headers: {
            'apikey': sbKey,
            'Authorization': 'Bearer ' + sbKey,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({ ref: ref, platform: platform })
        }).then(go, go);
      } catch (e) {
        go();
      }
      setTimeout(go, 800);
    })();
  </script>

  <section class="section">
    <div class="container get">
      <p class="eyebrow">Get Pick-Up</p>
      <h1>Find people to play with near you.</h1>
      <p class="lead">
        On your phone this page opens the right store by itself. On a computer,
        scan the code with your phone's camera or use the buttons below.
      </p>

      <StoreLinks variant="centered" qr />
    </div>
  </section>
</BaseLayout>

<style>
  .get {
    max-width: 640px;
    text-align: center;
  }
  .get h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin-block: var(--space-xs) var(--space-sm);
  }
  .get .lead { margin-inline: auto; }
</style>
